<Window x:Class="KachalinSemen_PRAK6_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KachalinSemen_PRAK6_WPF"
        mc:Ignorable="d"
        Title="Медицинская информационная система" Height="500" Width="800" Background="{DynamicResource WindowColor}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <WrapPanel Style="{StaticResource FirstWrapPanel}">
                <Button>Назад</Button>
                <Button Style="{StaticResource UpdateButton}">Сохранить</Button>
                <Button Style="{StaticResource DeleteButton}">Удалить</Button>
                <Button Style="{StaticResource ThemeSwitch}" Click="ChangeThemeButton_Click">Тема</Button>

            </WrapPanel>
            <WrapPanel>
                <WrapPanel Style="{StaticResource FirstWrapPanel2}">
                    
                    <TextBlock Style="{StaticResource NullBlock}">Id</TextBlock>
                    <TextBlock Style="{StaticResource NullBlock}">ФИО</TextBlock>
                    <TextBlock Style="{StaticResource NullBlock}">Диагнозы</TextBlock>
                    <TextBlock Style="{StaticResource NullBlock}">На осмотре</TextBlock>
                    <TextBlock Style="{StaticResource NullBlock}">Группа крови</TextBlock>
                    <TextBlock Style="{StaticResource NullBlock}">Состояние</TextBlock>
                    <TextBlock Style="{StaticResource NullBlock}">Пол</TextBlock>
                </WrapPanel>
                <WrapPanel Style="{StaticResource FirstWrapPanel3}">
                    <TextBox Style="{StaticResource TextBlokNo}">123456</TextBox>
                    <TextBox>Jon Killian</TextBox>
                    <TextBox Style="{StaticResource TextBloka}">Bublik</TextBox>
                    <CheckBox></CheckBox>
                    <ComboBox>
                        <ComboBoxItem>A+</ComboBoxItem>
                        <ComboBoxItem>A-</ComboBoxItem>
                        <ComboBoxItem>B+</ComboBoxItem>
                        <ComboBoxItem>B-</ComboBoxItem>
                    </ComboBox>
                    <ProgressBar></ProgressBar>
                </WrapPanel>
            </WrapPanel>
            <WrapPanel Style="{StaticResource FirstWrapPanel4}">
                <RadioButton>M</RadioButton>
                <RadioButton>Ж</RadioButton>
            </WrapPanel>
            <WrapPanel Style="{StaticResource FirstWrapPanel5}">
                <TextBlock>Категории приема</TextBlock>
                <RadioButton>Экстренная</RadioButton>
                <RadioButton>Неотложная</RadioButton>
                <RadioButton>Несрочная</RadioButton>
            </WrapPanel>
        </StackPanel>
        
    </Grid>
</Window>
